# Copy to .env and fill in. All of these must also be set in the Render
# dashboard for the deployed service.

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: override the database name (defaults to "Chattu").
# MONGO_DB_NAME=Chattu

# Long random string used to sign auth cookies. Required - the server refuses
# to start without it.
JWT_SECRET=

# Secret used to log into /admin.
ADMIN_SECRET_KEY=

# DEVELOPMENT or PRODUCTION. This controls cookie flags: PRODUCTION sends
# SameSite=None; Secure cookies (required for a cross-site Vercel -> Render
# setup), DEVELOPMENT uses SameSite=Lax so login works over plain http.
NODE_ENV=DEVELOPMENT

# Browser origin(s) allowed by CORS. Comma-separate to allow several, e.g.
# preview deployments: https://chattu.vercel.app,https://chattu-git-dev.vercel.app
CLIENT_URL=http://localhost:5173

# Render provides PORT automatically; only set this locally.
PORT=3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
